<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kasane.Host</RootNamespace>
    <AssemblyName>Kasane</AssemblyName>
    <Product>3D施工検討Viewer Kasane</Product>
    <!-- バージョンはリポジトリ直下の VERSION が唯一の正（SSOT）。ここに数字を書かない -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 配布はランタイム同梱の単一ファイル（scripts/build.ps1 で publish） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- .NET のメッセージ類は日本語だけを同梱する（英語は既定で内蔵） -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- WebView2 パッケージが WPF 版も参照するための警告（WinForms 版だけを使う） -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <!-- アプリのアイコン（app.ico）。置いてあれば exe とウィンドウに使う。無ければ既定のアイコンのまま -->
  <PropertyGroup Condition="Exists('app.ico')">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="Exists('app.ico')">
    <EmbeddedResource Include="app.ico" LogicalName="Kasane.app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <!-- 単体テスト（app/Kasane.Host.Tests）から internal のコンストラクタ（変換エンジンの差し替え）を使う -->
  <ItemGroup>
    <InternalsVisibleTo Include="Kasane.Host.Tests" />
  </ItemGroup>
</Project>
