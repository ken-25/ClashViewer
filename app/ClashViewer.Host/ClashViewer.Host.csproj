<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClashViewer.Host</RootNamespace>
    <AssemblyName>ClashViewer</AssemblyName>
    <Product>干渉ビューア</Product>
    <Version>0.1.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 配布はランタイム同梱の単一ファイル（scripts/build.ps1 で publish） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- .NET のメッセージ類は日本語だけを同梱する（英語は既定で内蔵） -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- WebView2 パッケージが WPF 版も参照するための警告（WinForms 版だけを使う） -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
