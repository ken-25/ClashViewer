{
  "name": "clash-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "干渉ビューアの画面（WebView2 上で動く）",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "build": "node scripts/copy-assets.mjs && vite build",
    "watch": "node scripts/copy-assets.mjs && vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@thatopen/fragments": "3.4.7",
    "three": "0.186.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
